# ============================================================
# .gitignore — OCR Platform Monorepo
# ============================================================

# ====== Java / Maven ======
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
# NOTE : Maven Wrapper (.mvn/, mvnw, mvnw.cmd) DOIT etre commite.
# Sans lui, la CI Linux echoue ("./mvnw: No such file").
# Ne PAS l'ignorer ici.

# ====== Gradle (au cas ou) ======
.gradle/
build/

# ====== Python ======
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
*.egg

# ====== IDE — IntelliJ IDEA ======
.idea/
*.iml
*.iws
*.ipr
out/

# ====== IDE — VS Code ======
.vscode/
*.code-workspace

# ====== IDE — Eclipse ======
.classpath
.project
.settings/
.metadata/

# ====== OS — Windows ======
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ====== OS — macOS / Linux ======
.DS_Store
*.swp
*.swo

# ====== Logs ======
logs/
*.log
log/

# ====== Secrets et configurations locales ======
# IMPORTANT : ne JAMAIS commiter de secrets !
# On ignore TOUS les .env (sauf les *.example qui sont des templates).
.env
.env.*
*.pem
*.key
secrets/
application-local.yml
application-local.properties

# Mais on AUTORISE les fichiers d'exemple (templates documentes)
!.env.example
!.env.*.example

# ====== Docker ======
# Volumes de donnees Docker (locaux)
docker-data/
.docker/

# ====== Fichiers temporaires ======
*.tmp
*.bak
*.swp
*~

# ====== Coverage / Reports ======
coverage/
.coverage
htmlcov/
.tox/
.nox/

# ====== Node (si jamais front plus tard) ======
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
