# ============================================================================
# .env.staging.example — Template pour environnement STAGING
# ----------------------------------------------------------------------------
# Variables d'environnement requises pour deployer document-service en staging.
#
# Usage :
#   1. Copier ce fichier en .env.staging (NE PAS COMMITER .env.staging)
#   2. Remplir les vraies valeurs (jamais celles d'exemple)
#   3. Charger via : docker compose --env-file .env.staging up -d
#
# IMPORTANT : .env.staging est dans .gitignore, jamais commite.
# ============================================================================

# ===== Profile Spring Boot =====
SPRING_PROFILES_ACTIVE=staging

# ===== MySQL =====
# URL JDBC complete (host = nom du service Docker en interne)
MYSQL_URL=jdbc:mysql://mysql:3306/documents_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
MYSQL_USER=ocr_staging_user
MYSQL_PASSWORD=CHANGE_ME_strong_password_here
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_here
MYSQL_DATABASE=documents_db

# ===== Keycloak =====
# Admin console Keycloak (pour l'UI sur localhost:8180 du VPS)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# URL publique du Keycloak staging (visible par les clients)
KEYCLOAK_ISSUER_URI=https://auth.staging.example.com/realms/ocr-platform
KEYCLOAK_JWK_SET_URI=https://auth.staging.example.com/realms/ocr-platform/protocol/openid-connect/certs

# ===== Kafka =====
# Nom du service Docker en interne
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Topics Kafka (defaut : documents.uploaded)
KAFKA_TOPIC_DOC_UPLOADED=documents.uploaded

# ===== MinIO =====
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=documents-staging
