<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================================
    Logback configuration — document-service
    ============================================================================

    Configuration profile-aware :
      - dev   : logs console compacts, stack traces filtrées (frames serveur masquées)
      - test  : logs console minimaux (ne pollue pas la sortie de tests)
      - prod  : logs console JSON structurés (pour ingestion Loki/ELK)

    Stack filtering : on masque les frames Tomcat/Servlet/Spring boilerplate
    pour ne garder QUE les frames de notre code et les vraies causes racines.
    ============================================================================
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Inclut les conventions Spring Boot par défaut (couleurs console, levels, etc.) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- ==========================================================================
         Property : packages à exclure des stack traces
         %ex{full,EXCLUDED_FRAMES} → tronque les frames matchant ces packages
         ========================================================================== -->
    <property name="EXCLUDED_FRAMES"
              value="
                  jakarta.servlet,
                  jdk.internal,
                  java.lang.reflect,
                  org.apache.catalina,
                  org.apache.coyote,
                  org.apache.tomcat,
                  org.springframework.aop,
                  org.springframework.cglib,
                  org.springframework.web.filter,
                  org.springframework.web.servlet.DispatcherServlet,
                  org.springframework.web.servlet.FrameworkServlet,
                  org.springframework.web.servlet.mvc,
                  org.springframework.web.method,
                  sun.reflect
              "/>

    <!-- ==========================================================================
         Pattern console DEV : compact + couleur + stack filtrée
         ========================================================================== -->
    <property name="CONSOLE_LOG_PATTERN_DEV"
              value="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%-15.15thread]){magenta} %clr(%-40.40logger{0}){cyan} - %msg%n%ex{full,${EXCLUDED_FRAMES}}"/>

    <!-- ==========================================================================
         Pattern console PROD : JSON structuré (ready pour Loki/ELK)
         (Phase 6 : on remplacera par logstash-logback-encoder pour du vrai JSON)
         ========================================================================== -->
    <property name="CONSOLE_LOG_PATTERN_PROD"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger - traceId=%X{traceId:-} correlationId=%X{correlationId:-} - %msg%n%ex{full,${EXCLUDED_FRAMES}}"/>

    <!-- ==========================================================================
         Profile DEV : pattern compact, stack filtrée
         ========================================================================== -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%-15.15thread] [%X{correlationId:-no-corr}] %-40.40logger{0} - %msg%n%ex{full,${EXCLUDED_FRAMES:-}}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Niveaux fins en DEV : on voit ce qui se passe dans notre code -->
        <logger name="com.ocrplatform" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>

        <!-- On baisse le bruit -->
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.web.servlet.mvc.method.annotation.ExceptionHandlerExceptionResolver" level="ERROR"/>
        <logger name="org.springframework.web.servlet.DispatcherServlet" level="WARN"/>
    </springProfile>

    <!-- ==========================================================================
         Profile TEST : minimal, pour ne pas polluer Maven test
         ========================================================================== -->
    <springProfile name="test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.ocrplatform" level="INFO"/>
    </springProfile>

    <!-- ==========================================================================
         Profile PROD : JSON-ready pour ingestion par Loki/Grafana ou ELK
         ========================================================================== -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN_PROD}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.ocrplatform" level="INFO"/>
    </springProfile>

</configuration>