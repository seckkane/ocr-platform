# ============================================================================
# Files NOT to copy into Docker build context
# ============================================================================

# Virtual env (re-cree dans le builder)
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# Docs (pas necessaires pour le runtime)
README.md
docs/

# Tests (pas dans l'image prod)
tests/

# OS
.DS_Store
Thumbs.db

# Env files (NE JAMAIS embarquer dans une image)
.env
.env.*
