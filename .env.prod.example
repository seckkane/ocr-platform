# ============================================================================
# .env.prod.example — Template pour environnement PRODUCTION
# ----------------------------------------------------------------------------
# Variables d'environnement requises pour deployer document-service en prod.
#
# REGLES ABSOLUES PROD :
#   - Mots de passe : minimum 32 caracteres, generes aleatoirement
#   - URLs Keycloak : HTTPS obligatoire
#   - Credentials JAMAIS partages dans Slack/email/Git
#   - Idealement : utiliser un secrets manager (Vault, AWS SM, Doppler...)
#
# Usage :
#   1. Copier ce fichier en .env.prod (sur le VPS uniquement)
#   2. Remplir avec les VRAIS secrets de production
#   3. Permissions strictes : chmod 600 .env.prod
#   4. Charger via : docker compose --env-file .env.prod up -d
# ============================================================================

# ===== Profile Spring Boot =====
SPRING_PROFILES_ACTIVE=prod

# ===== MySQL =====
MYSQL_URL=jdbc:mysql://mysql:3306/documents_db?useSSL=true&serverTimezone=UTC
MYSQL_USER=ocr_prod_user
MYSQL_PASSWORD=GENERATE_STRONG_PASSWORD_MIN_32_CHARS
MYSQL_ROOT_PASSWORD=GENERATE_STRONG_ROOT_PASSWORD_MIN_32_CHARS
MYSQL_DATABASE=documents_db

# ===== Keycloak admin console =====
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=GENERATE_STRONG_KEYCLOAK_ADMIN_PASSWORD

# ===== Keycloak (HTTPS obligatoire) =====
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/ocr-platform
KEYCLOAK_JWK_SET_URI=https://auth.example.com/realms/ocr-platform/protocol/openid-connect/certs

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_DOC_UPLOADED=documents.uploaded

# ===== MinIO =====
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=GENERATE_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=GENERATE_STRONG_SECRET_KEY_MIN_32_CHARS
MINIO_BUCKET=documents
